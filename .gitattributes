# ============================================
# 换行符策略
# ============================================
# 仓库内部统一存 LF，检出到 Windows 时自动转成 CRLF。
# Keil MDK 习惯 CRLF，这样既保证本地打开正常，也方便以后在 Linux 上编译。
* text=auto eol=crlf

# ---------- 二进制文件：不做任何换行符转换 ----------
*.hex   binary
*.bin   binary
*.axf   binary
*.o     binary
*.lib   binary
*.a     binary
*.png   binary
*.jpg   binary
*.pdf   binary
*.zip   binary

# ---------- Keil 工程文件：按文本处理，保留 CRLF ----------
*.uvprojx  text eol=crlf
*.uvoptx   text eol=crlf
*.uvguix.* text eol=crlf
*.sct      text eol=crlf
*.s        text eol=crlf

# ---------- 源码：CRLF 保持 Keil 原样 ----------
*.c    text eol=crlf
*.h    text eol=crlf
